generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // 开启PostgreSQL扩展功能
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector"), postgis] // 开启 pgvector 和 postgis 扩展
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

enum AgentMessageKind {
  TEXT
  PHOTO_RESULTS
}

enum AgentMessageStatus {
  COMPLETED
  INTERRUPTED
  ERROR
}

model Photo {
  id              Int              @id @default(autoincrement())
  filename        String
  originalPath    String           @unique
  size            Int
  mimeType        String
  originalKey     String
  thumbSmallKey   String
  thumbLargeKey   String
  videoKey        String?
  width           Int?
  height          Int?
  takenAt         DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now())
  dominantColor   String?
  top             Boolean          @default(false)
  photoExif         PhotoExif?
  location          Location?
  photoAiAnalysis   PhotoAiAnalysis?
  agentMessagePhotos AgentMessagePhoto[]

  @@map("photos")
}

model PhotoExif {
  id                      Int     @id @default(autoincrement())
  photoId                 Int     @unique
  make                    String?
  model                   String?
  lensModel               String?
  fNumber                 Float?
  exposureTime            String?
  iso                     Int?
  focalLength             Float?
  exposureBias            Float?
  latitude                Float?
  longitude               Float?
  altitude                Float?
  colorSpace              String?
  exposureMode            String?
  exposureProgram         String?
  flash                   String?
  focalLengthIn35mmFormat Float?
  gpsTimeStamp            String?
  lensMake                String?
  meteringMode            String?
  rawData                 Json?
  software                String?
  whiteBalance            String?
  exifImageHeight         Int?
  exifImageWidth          Int?
  GPSLatitude             Int[]   @default([])
  GPSLatitudeRef          String?
  GPSLongitude            Int[]   @default([])
  GPSLongitudeRef         String?
  bearingDirection        String?
  gpsImgDirection         Float?
  photos                  Photo   @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@map("photo_exifs")
}

model Location {
  id               Int     @id @default(autoincrement())
  photoId          Int     @unique
  latitude         Float
  longitude        Float
  GPSLatitude      Int[]   @default([])
  GPSLongitude     Int[]   @default([])
  altitude         Float?
  bearing          Float?
  bearingDirection String?
  /// 街道 / 镇 / 乡，比 adcode 粒度更细，故不在 Region 中
  township         String?
  adcode           String?
  formattedAddress String?
  neighborhood     String?
  type             String?
  rawData          Json?
  photo            Photo   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  region           Region? @relation(fields: [adcode], references: [adcode], onDelete: Restrict)

  @@index([latitude, longitude])
  @@index([adcode])
  @@map("locations")
}

/// 行政区划字典。adcode 是高德的区县级代码，天然主键。
/// 不含 township —— 街道比 adcode 粒度更细，一个区下有多个街道，
/// 放进来会破坏主键唯一性，故留在 Location。
model Region {
  adcode    String     @id
  country   String?
  province  String?
  city      String?
  district  String?
  locations Location[]

  @@index([province, city, district])
  @@map("regions")
}

model PhotoAiAnalysis {
  id           Int                          @id @default(autoincrement())
  photoId      Int                          @unique @map("photo_id")
  theme        String?
  description  String?
  tags         String[]
  embedding    Unsupported("vector(1024)")? // 向量字段
  tagEmbedding Unsupported("vector(1024)")? @map("tag_embedding")
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime                     @default(now()) @updatedAt @map("updated_at")
  photo        Photo                        @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@map("photo_ai_analyses")
}

/// 登录接入前，visitorId 由 HTTP-only 随机 cookie 提供；后续可迁移为用户归属。
model AgentConversation {
  id        String         @id @default(uuid())
  visitorId String         @map("visitor_id")
  title     String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at")
  messages  AgentMessage[]

  @@index([visitorId, updatedAt])
  @@map("agent_conversations")
}

/// 可展示、可排序的对话记录；与 LangGraph checkpoint 分工，不存模型内部上下文。
model AgentMessage {
  id             String             @id @default(uuid())
  conversationId String             @map("conversation_id")
  sequence       Int
  role           AgentMessageRole
  kind           AgentMessageKind   @default(TEXT)
  status         AgentMessageStatus @default(COMPLETED)
  content        String             @db.Text
  photoTotal     Int?               @map("photo_total")
  createdAt      DateTime           @default(now()) @map("created_at")
  conversation   AgentConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  photoResults   AgentMessagePhoto[]

  @@unique([conversationId, sequence])
  @@index([conversationId, sequence])
  @@map("agent_messages")
}

/// 一条 Agent 照片结果中的稳定引用与显示顺序；签名 URL 每次回放时重新生成。
model AgentMessagePhoto {
  messageId String       @map("message_id")
  photoId   Int          @map("photo_id")
  position  Int
  message   AgentMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  photo     Photo        @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([messageId, photoId])
  @@unique([messageId, position])
  @@index([photoId])
  @@map("agent_message_photos")
}
