# ============================================
# 照片足迹 (Photo Map) — 环境变量配置
# ============================================
# 复制此文件为 .env.local 并填入实际值:
#   cp .env.example .env.local
#
# Docker 部署请复制为 .env.docker:
#   cp .env.example .env.docker
#
# 标注说明：
#   [必填]  缺失会导致对应功能报错或整页不可用
#   [可选]  代码内有默认值，或仅特定功能需要
# 注意：env_file 是容器创建时读取的，改完需 docker compose up -d --force-recreate
# ============================================

# ---------- 数据库 ----------
# [必填] PostgreSQL 连接字符串。需要 pgvector 与 postgis 扩展
# 本地开发填 localhost；Docker 内填容器名（如 photo-map-db）
# Agent 的 LangGraph checkpoint 表也建在这个库里，首次对话时自动创建
DATABASE_URL="postgresql://user:password@localhost:5432/photomap_db"

# ---------- MinIO / S3 对象存储 ----------
# [必填] 服务端读写用的地址。图片对外不发 presigned URL，
# 而是统一走 /api/image 代理，因此只需要这一个服务端可达的地址
# 宿主机运行填 http://localhost:9000；Docker 内填容器名
MINIO_INTERNAL_ENDPOINT="http://photo-map-minio:9000"
# [必填]
MINIO_ACCESS_KEY="your_minio_access_key"
MINIO_SECRET_KEY="your_minio_secret_key"
MINIO_BUCKET="photo-map-bucket"
# [可选] 默认空串。MinIO 不校验区域，填 us-east-1 兼容 S3 客户端即可
MINIO_REGION="us-east-1"

# ---------- 图片代理签名 ----------
# [可选，生产必改] /api/image 的 HMAC 签名密钥，默认值写在代码里
# 保持默认等于任何人都能伪造 token 直接取图
IMAGE_TOKEN_SECRET="change_me_to_a_long_random_string"
# [可选] 站点对外地址，用于把图片拼成绝对 URL（分享、OG 图等场景）
# 留空则输出 /api/image?... 相对路径，站内展示不受影响
APP_URL="https://yourdomain.com"

# ---------- 管理员 ----------
# [生产必填] /admin 的口令校验（middleware 与 server/auth 共用）
# 开发环境（NODE_ENV !== production）直接放行，不读此项；
# 生产环境未配置时一律拒绝访问，后台会进不去
ADMIN_PASSWORD="your_admin_password"

# ---------- 高德地图 API ----------
# [必填] 逆地理编码（坐标 → 省市区/地址），照片入库时解析拍摄地
# 缺失不会崩，但所有照片都拿不到地点信息
# 申请地址: https://console.amap.com/dev/key/app
AMAP_API_KEY="your_amap_api_key"

# ---------- 地图（前端，构建期内联） ----------
# 注意：NEXT_PUBLIC_ 前缀的值在 next build 时就被写进客户端产物，
# 改这三项必须重新构建镜像，只重启容器不生效
# [必填] 自建地图瓦片样式（MapLibre Style JSON），按主题切换
NEXT_PUBLIC_MAP_DARK_STYLE_URL="https://map.yourdomain.com/styles/dark/style.json"
NEXT_PUBLIC_MAP_BRIGHT_STYLE_URL="https://map.yourdomain.com/styles/bright/style.json"
# [必填] 默认地图中心点，格式为 "经度,纬度"
# 代码里是 split(',') 直接取值，缺失会让地图组件在加载时就抛错
NEXT_PUBLIC_MAP_DEFAULT_CENTER="116.39123,39.90703"

# ==========================================================
# AI 模型：按用途分三组，不按平台分组
# ==========================================================
# 每组四项：*_API_TYPE / *_MODEL / *_API_URL / *_API_KEY
#
# *_API_TYPE 只区分调用协议，不区分平台，默认 openai：
#   ollama → 本地 / 局域网 Ollama 原生接口，不需要 API_KEY；
#            URL 末尾带不带 /api 都可以
#   openai → OpenAI 兼容端点（阿里云百炼、魔搭，以及任何兼容该协议的平台）
# 换平台或接新平台只改这里，代码不需要改。
#
# 三组互不影响，可以分别落在不同平台。低配机器常见的搭配是：
# 对话与图片分析放云端，向量留本地（换向量平台要重算历史数据，见下）。
# ==========================================================

# ---------- 对话（Agent 与查询规划） ----------
# [必填] ollama / openai
CHAT_API_TYPE="ollama"
# [必填] Ollama 填模型 tag；云端填该平台的模型 ID
CHAT_MODEL="qwen3:4b-q4_K_M"
# [必填] 宿主机运行填 http://localhost:11434
# Docker 内填 http://host.docker.internal:11434（compose 需配 extra_hosts:host-gateway），
# 且宿主机的 Ollama 要监听 0.0.0.0，否则容器过来的连接会被拒（ECONNREFUSED）
CHAT_API_URL="http://host.docker.internal:11434"
# 走 Ollama 时保持注释；填了即切换为云端调用
# CHAT_API_KEY=""

# 切到魔搭社区 ModelScope 的写法（模型 ID 带组织前缀）：
# CHAT_API_TYPE="openai"
# CHAT_MODEL="Qwen/Qwen3-32B"
# CHAT_API_URL="https://api-inference.modelscope.cn/v1/"
# CHAT_API_KEY="ms-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
#
# 切到阿里云百炼 DashScope 的写法：
# CHAT_API_TYPE="openai"
# CHAT_MODEL="qwen-turbo"
# CHAT_API_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# CHAT_API_KEY="sk-xxxxxxxx"
#
# 注意：对话模型必须支持 function calling，否则 Agent 调不起照片检索工具；
# 图像描述类模型（如 iic/mplug_image-captioning）不能用在这一组。

# ---------- 图片分析（入库时生成描述与标签） ----------
# [必填] ollama / openai
VISION_API_TYPE="ollama"
# [必填] Ollama 需先 ollama pull；云端填该平台的视觉模型 ID
VISION_MODEL="qwen3-vl:2b"
# [必填]
VISION_API_URL="http://host.docker.internal:11434"
# 走 Ollama 时保持注释
# VISION_API_KEY=""

# ---------- 向量嵌入 ----------
# [必填] ollama / openai
EMBEDDING_API_TYPE="ollama"
# [必填] 必须输出 1024 维，与库表的 vector(1024) 对应。
# 换模型或换平台前先确认维度：维度一变，已入库的历史向量全部失效，
# 需要改列定义并重算全部照片
EMBEDDING_MODEL="bge-m3"
# [必填]
EMBEDDING_API_URL="http://host.docker.internal:11434"
# 走 Ollama 时保持注释
# EMBEDDING_API_KEY=""

# ---------- LangSmith 链路追踪（可选） ----------
# 由 langsmith SDK 自动读取，不在业务代码里引用
# 生产建议关闭：开启会把对话内容发往 LangSmith
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="photo_map"
